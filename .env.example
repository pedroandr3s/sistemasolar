# Copia este archivo como .env.local (desarrollo) o .env.production.local (producción).
# No contiene secretos: la app no usa claves ni credenciales.

# URL pública definitiva del sitio, SIN barra final y SIN rutas.
# Los códigos QR de producción se generan con esta URL (npm run qr:prod) y
# el generador rechaza localhost, IP de red local, túneles temporales y dominios de ejemplo.
# Ejemplo (reemplázalo por el dominio real cuando exista):
# NEXT_PUBLIC_SITE_URL=https://sistemasolar.tudominio.cl
NEXT_PUBLIC_SITE_URL=

# Opcional: proveedor de teselas del mapa base. Por defecto, OpenStreetMap.
# Para un uso turístico con muchas visitas, la política de uso de OpenStreetMap
# pide usar un proveedor propio o comercial: https://operations.osmfoundation.org/policies/tiles/
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">colaboradores de OpenStreetMap</a>
